{
  "schemaVersion": 1,
  "id": "quizz",
  "version": "1.3.0",
  "title": {
    "en": "The Million Quiz",
    "fr": "Le Quiz Million",
    "tl": "Milyong Quiz"
  },
  "description": {
    "en": "A shared quiz show. Flags, fruit, capitals and European monarchs. Choose the mode, question count and timer.",
    "fr": "Un quiz collectif : drapeaux, fruits, capitales et souverains européens. Mode, nombre de questions et durée au choix.",
    "tl": "Quiz para sa lahat: watawat, prutas, kabisera at mga monarka. Piliin ang mode, dami ng tanong at oras."
  },
  "author": "Manaty",
  "license": "MIT",
  "languages": [
    "en",
    "fr",
    "tl"
  ],
  "players": {
    "min": 1,
    "max": null
  },
  "durationMinutes": 120,
  "runtime": "quickjs-v1",
  "entry": "dist/game.rmg.json",
  "permissions": [],
  "options": {
    "quizId": {
      "label": {
        "en": "Questionnaire",
        "fr": "Questionnaire",
        "tl": "Mga tanong"
      },
      "values": [
        "flags",
        "fruits",
        "capitals",
        "kings"
      ],
      "default": "flags"
    },
    "mode": {
      "label": {
        "en": "Game mode",
        "fr": "Mode de jeu",
        "tl": "Mode ng laro"
      },
      "values": [
        "ranking",
        "elimination",
        "cooperative"
      ],
      "default": "ranking"
    },
    "questionCount": {
      "label": {
        "en": "Questions to play",
        "fr": "Questions à jouer",
        "tl": "Dami ng tanong"
      },
      "type": "integer",
      "min": 1,
      "max": 100,
      "default": 10
    },
    "seconds": {
      "label": {
        "en": "Seconds per question",
        "fr": "Secondes par question",
        "tl": "Segundo bawat tanong"
      },
      "values": [
        15,
        30,
        45,
        60,
        90
      ],
      "default": 30
    },
    "order": {
      "label": {
        "en": "Question order",
        "fr": "Ordre des questions",
        "tl": "Ayos ng tanong"
      },
      "values": [
        "random",
        "authored"
      ],
      "default": "random"
    },
    "difficultyMin": {
      "label": {
        "en": "Minimum level (1 primary – 4 advanced)",
        "fr": "Niveau minimum",
        "tl": "Pinakamababang antas"
      },
      "type": "integer",
      "min": 1,
      "max": 4,
      "default": 1
    },
    "difficultyMax": {
      "label": {
        "en": "Maximum level (1 primary – 4 advanced)",
        "fr": "Niveau maximum",
        "tl": "Pinakamataas na antas"
      },
      "type": "integer",
      "min": 1,
      "max": 4,
      "default": 4
    }
  }
}
